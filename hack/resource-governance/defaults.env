# Baseline names
LIMITRANGE_NAME=baseline-limits
RESOURCEQUOTA_NAME=baseline-quota

# Namespace filter used when --namespaces is not passed.
EXCLUDE_NAMESPACES_REGEX='^(kube-system|kube-public|kube-node-lease)$'

# LimitRange defaults
DEFAULT_REQUEST_CPU=200m
DEFAULT_REQUEST_MEMORY=256Mi
DEFAULT_LIMIT_CPU=500m
DEFAULT_LIMIT_MEMORY=512Mi
MIN_CPU=50m
MIN_MEMORY=64Mi
MAX_CPU=2
MAX_MEMORY=2Gi

# ResourceQuota defaults
QUOTA_REQUESTS_CPU=8
QUOTA_REQUESTS_MEMORY=16Gi
QUOTA_LIMITS_CPU=16
QUOTA_LIMITS_MEMORY=32Gi
QUOTA_PODS=100
