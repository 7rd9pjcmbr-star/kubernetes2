# Internal upstream profile (example — no secrets)
# Copy to .env for local use:
#   cp .env.internal.example .env
#
# If upstream uses Basic Auth, set in local .env only (never commit):
#   PROXY_UPSTREAM_BASIC_AUTH=username:password

PROXY_LISTEN_ADDRESS=:8080
PROXY_UPSTREAMS=https://42.115.10.251
PROXY_READ_TIMEOUT=30s
PROXY_WRITE_TIMEOUT=30s
PROXY_IDLE_TIMEOUT=60s
PROXY_SHUTDOWN_TIMEOUT=20s
PROXY_REQUEST_TIMEOUT=45s
PROXY_AUTH_TOKEN=
PROXY_RATE_LIMIT_RPS=0
PROXY_RATE_LIMIT_BURST=0
PROXY_TRUST_FORWARDED=true
PROXY_INSECURE_SKIP_VERIFY=true
PROXY_UPSTREAM_BASIC_AUTH=
PROXY_LOG_FORMAT=json
PROXY_SERVICE_NAME=proxy-internal
PROXY_TRACE_OTLP_ENDPOINT=
PROXY_TRACE_OTLP_INSECURE=true
PROXY_TRACE_SAMPLE_RATIO=1.0
