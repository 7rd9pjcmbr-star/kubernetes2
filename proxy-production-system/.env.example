# Control plane HTTP (:8080) — /healthz + static UI; upstream placeholder when gateway is on
PROXY_LISTEN_ADDRESS=:8080
PROXY_UPSTREAMS=
PROXY_STATIC_ROOT=/static
PROXY_READ_TIMEOUT=15s
PROXY_WRITE_TIMEOUT=15s
PROXY_IDLE_TIMEOUT=60s
PROXY_SHUTDOWN_TIMEOUT=20s

# VN player-style forward proxy gateway (HTTP + SOCKS5)
PROXY_GATEWAY_ENABLED=true
# Residential upstream (DataImpulse VN): LOGIN__cr.vn:PASSWORD@gw.dataimpulse.com:823
PROXY_POOL=http://YOUR_LOGIN__cr.vn:YOUR_PASSWORD@gw.dataimpulse.com:823|residential|VN|elite|50|99
# Optional CSV of pool lines (one entry per line, same format as PROXY_POOL entries)
PROXY_POOL_FILES=
PROXY_GATEWAY_HTTP_ADDRESS=:8888
PROXY_GATEWAY_SOCKS_ADDRESS=:1080
PROXY_GATEWAY_ADMIN_ADDRESS=:9090
PROXY_GATEWAY_USER=player
PROXY_GATEWAY_PASS=change-me
PROXY_ROTATION=quality
PROXY_STICKY_TTL=10m
PROXY_HEALTH_INTERVAL=30s
PROXY_CLIENT_WHITELIST=
PROXY_ADMIN_TOKEN=change-me-admin
PROXY_ELITE_MODE=true

# MongoDB control plane (recommended production path)
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=proxy_gateway
MONGO_COLLECTION=backends
MONGO_SYNC_INTERVAL=10s
MONGO_METRICS_FLUSH_INTERVAL=30s
MONGO_TELEGRAM_COLLECTION=telegram_chats

# @TondaithanhBot — quan tri pool qua Telegram + MongoDB
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=8335277904
TELEGRAM_ALERT_INTERVAL=30s
