PROXY_LISTEN_ADDRESS=:8080
PROXY_UPSTREAMS=http://echo-a:8081,http://echo-b:8082
PROXY_READ_TIMEOUT=15s
PROXY_WRITE_TIMEOUT=15s
PROXY_IDLE_TIMEOUT=60s
PROXY_SHUTDOWN_TIMEOUT=20s
PROXY_REQUEST_TIMEOUT=30s
PROXY_AUTH_TOKEN=
PROXY_RATE_LIMIT_RPS=0
PROXY_RATE_LIMIT_BURST=0
PROXY_TRUST_FORWARDED=false
PROXY_LOG_FORMAT=json
PROXY_SERVICE_NAME=proxy-production-system
PROXY_TRACE_OTLP_ENDPOINT=
PROXY_TRACE_OTLP_INSECURE=true
PROXY_TRACE_SAMPLE_RATIO=1.0
