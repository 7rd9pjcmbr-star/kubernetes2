BIN := bin/proxy
GO := GOWORK=off go
PROXY_URL ?= http://127.0.0.1:8080
REPO_PROXY_ENV := .repo-proxy.env

.PHONY: test build run repo-proxy-on repo-proxy-off repo-proxy-status

test:
	$(GO) test ./...

build:
	GOWORK=off CGO_ENABLED=0 go build -o $(BIN) ./cmd/proxy

run:
	GOWORK=off PROXY_UPSTREAMS=http://localhost:8081,http://localhost:8082 go run ./cmd/proxy

# Write local proxy env for subsequent shell sessions (not committed).
repo-proxy-on:
	@test -n "$(PROXY_URL)" || (echo "PROXY_URL is required, e.g. PROXY_URL=http://127.0.0.1:8080" >&2; exit 2)
	@printf '%s\n' \
		'# Generated by make repo-proxy-on — local only' \
		"export PROXY_ON=1" \
		"export PROXY_URL=$(PROXY_URL)" \
		"export HTTP_PROXY=$(PROXY_URL)" \
		"export HTTPS_PROXY=$(PROXY_URL)" \
		"export ALL_PROXY=$(PROXY_URL)" \
		"export http_proxy=$(PROXY_URL)" \
		"export https_proxy=$(PROXY_URL)" \
		"export all_proxy=$(PROXY_URL)" \
		'export NO_PROXY=localhost,127.0.0.1,::1' \
		'export no_proxy=localhost,127.0.0.1,::1' \
		> $(REPO_PROXY_ENV)
	@echo "Wrote $(REPO_PROXY_ENV) (PROXY_URL=$(PROXY_URL))"
	@echo "Run: source ./$(REPO_PROXY_ENV)"

repo-proxy-off:
	@printf '%s\n' \
		'# Generated by make repo-proxy-off — local only' \
		'export PROXY_ON=0' \
		'unset PROXY_URL HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy' \
		> $(REPO_PROXY_ENV)
	@echo "Wrote $(REPO_PROXY_ENV) (proxy off). Run: source ./$(REPO_PROXY_ENV)"

repo-proxy-status:
	@if [ -f $(REPO_PROXY_ENV) ]; then echo "--- $(REPO_PROXY_ENV) ---"; cat $(REPO_PROXY_ENV); else echo "$(REPO_PROXY_ENV) missing (proxy not configured)"; fi

# Mapper AES decrypt workflow (portable — reuse anywhere)
INPUT ?=
.PHONY: mapper-decrypt mapper-decrypt-full mapper-decrypt-kit mapper-protocol

mapper-decrypt:
	@if [ -z "$(INPUT)" ]; then echo "Usage: make mapper-decrypt INPUT=file.json"; exit 2; fi
	python3 scripts/mapper_decrypt_workflow.py decrypt --input "$(INPUT)" --summary

mapper-decrypt-full:
	@if [ -z "$(INPUT)" ]; then echo "Usage: make mapper-decrypt-full INPUT=file.json"; exit 2; fi
	python3 scripts/mapper_decrypt_workflow.py decrypt --input "$(INPUT)" -o /tmp/mapper-decrypted.json
	@echo "saved /tmp/mapper-decrypted.json"

mapper-decrypt-kit:
	python3 scripts/mapper_decrypt_workflow.py bundle --output-dir ./mapper-decrypt-kit
	@echo "kit ready: ./mapper-decrypt-kit (set MAPPER_AES_KEY_B64 on target machine)"

mapper-protocol:
	python3 scripts/mapper_decrypt_workflow.py protocol
