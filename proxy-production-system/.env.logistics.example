# Logistics-only upstream profile (J&T Express)
# Copy to .env:
#   cp .env.logistics.example .env
#
# Scope: only logistics systems you operate/authorize.
# Do NOT add unrelated consumer/account combo lists.
#
# Optional Basic Auth for upstream (local .env only, never commit):
#   PROXY_UPSTREAM_BASIC_AUTH=username:password

PROXY_LISTEN_ADDRESS=:8080

# Primary logistics upstream (internal ops / CCTV network)
PROXY_UPSTREAMS=https://42.115.10.251

# To use HRM logistics portal instead, switch to:
# PROXY_UPSTREAMS=https://fast-hrm.jtexpress.vn:8080
# Or run two proxy instances with different ports/profiles.

PROXY_READ_TIMEOUT=30s
PROXY_WRITE_TIMEOUT=30s
PROXY_IDLE_TIMEOUT=60s
PROXY_SHUTDOWN_TIMEOUT=20s
PROXY_REQUEST_TIMEOUT=45s
PROXY_AUTH_TOKEN=
PROXY_RATE_LIMIT_RPS=0
PROXY_RATE_LIMIT_BURST=0
PROXY_TRUST_FORWARDED=true
PROXY_INSECURE_SKIP_VERIFY=true
PROXY_UPSTREAM_BASIC_AUTH=
PROXY_LOG_FORMAT=json
PROXY_SERVICE_NAME=proxy-logistics-jtexpress
PROXY_TRACE_OTLP_ENDPOINT=
PROXY_TRACE_OTLP_INSECURE=true
PROXY_TRACE_SAMPLE_RATIO=1.0
